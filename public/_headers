/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.furry.ist; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/404.html
  Cache-Control: no-cache
/style.css
  Cache-Control: public, max-age=14400, must-revalidate
/assets/*
  Cache-Control: public, max-age=14400, must-revalidate
/admin-assets/*
  Cache-Control: public, max-age=14400, must-revalidate
/icons/*
  Cache-Control: public, max-age=604800
